<Sequence DisplayName="ProcesarMorosos"><ui:InvokeCode DisplayName="Detectar vencidos y cruzar emails" Language="VBNet" Code="Dim hoy As DateTime = DateTime.Today&#xA;Dim meses As New Dictionary(Of String, Integer)()&#xA;meses(&quot;ene&quot;) = 1 : meses(&quot;feb&quot;) = 2 : meses(&quot;mar&quot;) = 3 : meses(&quot;abr&quot;) = 4 : meses(&quot;may&quot;) = 5 : meses(&quot;jun&quot;) = 6&#xA;meses(&quot;jul&quot;) = 7 : meses(&quot;ago&quot;) = 8 : meses(&quot;sep&quot;) = 9 : meses(&quot;set&quot;) = 9 : meses(&quot;oct&quot;) = 10 : meses(&quot;nov&quot;) = 11 : meses(&quot;dic&quot;) = 12&#xA;Dim res As New System.Data.DataTable()&#xA;res.Columns.Add(&quot;ID&quot;, GetType(String))&#xA;res.Columns.Add(&quot;Libro&quot;, GetType(String))&#xA;res.Columns.Add(&quot;Usuario&quot;, GetType(String))&#xA;res.Columns.Add(&quot;Email&quot;, GetType(String))&#xA;res.Columns.Add(&quot;F. Devolución&quot;, GetType(String))&#xA;res.Columns.Add(&quot;Días Atraso&quot;, GetType(Integer))&#xA;res.Columns.Add(&quot;Criticidad&quot;, GetType(String))&#xA;res.Columns.Add(&quot;Estado Notificación&quot;, GetType(String))&#xA;Dim correos As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)&#xA;If dtUsuarios IsNot Nothing Then&#xA;    For Each u As System.Data.DataRow In dtUsuarios.Rows&#xA;        Dim n As String = u(&quot;Nombre&quot;).ToString().Trim()&#xA;        If n &lt;&gt; &quot;&quot; AndAlso Not correos.ContainsKey(n) Then correos(n) = u(&quot;Email&quot;).ToString().Trim()&#xA;    Next&#xA;End If&#xA;Dim rx As New Regex(&quot;(\d{1,2})\s+(?:de\s+)?([a-zA-ZáéíóúÁÉÍÓÚ]+)\.?\s+(?:de\s+)?(\d{4})&quot;)&#xA;Dim vistos As New HashSet(Of String)()&#xA;Dim activos As Integer = 0&#xA;If dtPrestamos IsNot Nothing Then&#xA;    For Each r As System.Data.DataRow In dtPrestamos.Rows&#xA;        Dim id As String = r(&quot;ID&quot;).ToString().Trim()&#xA;        If id = &quot;&quot; OrElse Not vistos.Add(id) Then Continue For&#xA;        If r(&quot;Estado&quot;).ToString().Trim().Equals(&quot;Devuelto&quot;, StringComparison.OrdinalIgnoreCase) Then Continue For&#xA;        activos += 1&#xA;        Dim txt As String = r(&quot;FechaDevolucion&quot;).ToString().Trim()&#xA;        Dim fecha As DateTime = DateTime.MinValue&#xA;        Dim ok As Boolean = False&#xA;        Dim m As Match = rx.Match(txt)&#xA;        If m.Success Then&#xA;            Dim k As String = m.Groups(2).Value.ToLower().Substring(0, Math.Min(3, m.Groups(2).Value.Length))&#xA;            If meses.ContainsKey(k) Then&#xA;                Try&#xA;                    fecha = New DateTime(CInt(m.Groups(3).Value), meses(k), CInt(m.Groups(1).Value))&#xA;                    ok = True&#xA;                Catch&#xA;                    ok = False&#xA;                End Try&#xA;            End If&#xA;        End If&#xA;        If Not ok Then ok = DateTime.TryParse(txt, New System.Globalization.CultureInfo(&quot;es-PE&quot;), System.Globalization.DateTimeStyles.None, fecha)&#xA;        If Not ok OrElse fecha.Date &gt;= hoy Then Continue For&#xA;        Dim dias As Integer = CInt((hoy - fecha.Date).TotalDays)&#xA;        Dim crit As String = If(dias &lt;= 3, &quot;Leve&quot;, If(dias &lt;= 7, &quot;Moderado&quot;, &quot;Grave&quot;))&#xA;        Dim usuario As String = r(&quot;Usuario&quot;).ToString().Trim()&#xA;        Dim mail As String = &quot;&quot;&#xA;        If correos.ContainsKey(usuario) Then mail = correos(usuario)&#xA;        res.Rows.Add(id, r(&quot;Libro&quot;).ToString().Trim(), usuario, mail, fecha.ToString(&quot;dd/MM/yyyy&quot;), dias, crit, &quot;Pendiente&quot;)&#xA;    Next&#xA;End If&#xA;Dim dv As System.Data.DataView = res.DefaultView&#xA;dv.Sort = &quot;[Días Atraso] DESC&quot;&#xA;dtVencidos = dv.ToTable()&#xA;intActivos = activos"><ui:InvokeCode.Arguments><InArgument x:TypeArguments="sd:DataTable" x:Key="dtPrestamos">[in_dtPrestamos]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="dtUsuarios">[in_dtUsuarios]</InArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="dtVencidos">[out_dtVencidos]</OutArgument><OutArgument x:TypeArguments="x:Int32" x:Key="intActivos">[out_intActivos]</OutArgument></ui:InvokeCode.Arguments></ui:InvokeCode><ui:LogMessage DisplayName="Log" Level="Info" Message="[&quot;Activos vigentes: &quot; &amp; out_intActivos.ToString() &amp; &quot; | Vencidos: &quot; &amp; out_dtVencidos.Rows.Count.ToString()]" /></Sequence>
</Activity>
