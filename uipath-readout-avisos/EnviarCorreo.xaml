    <ui:InvokeCode ContinueOnError="{x:Null}" Code="out_Error = &quot;&quot;&#xA;Try&#xA;    If in_Pass Is Nothing OrElse in_Pass.Trim() = &quot;&quot; OrElse in_Pass.ToUpper().StartsWith(&quot;CAMBIAR&quot;) Then&#xA;        Throw New Exception(&quot;smtp_password en Config.xlsx no esta configurada (App Password de Gmail de 16 caracteres).&quot;)&#xA;    End If&#xA;    System.Net.ServicePointManager.SecurityProtocol = System.Net.SecurityProtocolType.Tls12&#xA;    Using msg As New System.Net.Mail.MailMessage()&#xA;        msg.From = New System.Net.Mail.MailAddress(in_User, &quot;Biblioteca ReadOut&quot;)&#xA;        For Each d As String In in_To.Split(New Char() {&quot;;&quot;c, &quot;,&quot;c}, StringSplitOptions.RemoveEmptyEntries)&#xA;            msg.To.Add(d.Trim())&#xA;        Next&#xA;        msg.Subject = in_Subject&#xA;        msg.SubjectEncoding = System.Text.Encoding.UTF8&#xA;        msg.Body = in_Body&#xA;        msg.BodyEncoding = System.Text.Encoding.UTF8&#xA;        msg.IsBodyHtml = True&#xA;        If Not String.IsNullOrWhiteSpace(in_Adjunto) AndAlso System.IO.File.Exists(in_Adjunto) Then&#xA;            msg.Attachments.Add(New System.Net.Mail.Attachment(in_Adjunto))&#xA;        End If&#xA;        Using smtp As New System.Net.Mail.SmtpClient(in_Server, in_Port)&#xA;            smtp.EnableSsl = in_Ssl&#xA;            smtp.Timeout = 30000&#xA;            smtp.Credentials = New System.Net.NetworkCredential(in_User, in_Pass.Replace(&quot; &quot;, &quot;&quot;))&#xA;            smtp.Send(msg)&#xA;        End Using&#xA;    End Using&#xA;Catch ex As Exception&#xA;    Dim e As Exception = ex&#xA;    Dim detalle As String = e.Message&#xA;    While e.InnerException IsNot Nothing&#xA;        e = e.InnerException&#xA;        detalle &amp;= &quot; -&gt; &quot; &amp; e.Message&#xA;    End While&#xA;    out_Error = &quot;SMTP (&quot; &amp; in_Server &amp; &quot;:&quot; &amp; in_Port.ToString() &amp; &quot;, ssl=&quot; &amp; in_Ssl.ToString() &amp; &quot;): &quot; &amp; detalle&#xA;End Try" DisplayName="Enviar correo SMTP (STARTTLS)" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
