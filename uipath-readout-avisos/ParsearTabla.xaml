<Sequence DisplayName="ParsearTabla"><ui:InvokeCode DisplayName="Parsear tabla HTML a DataTable" Language="VBNet" Code="Dim dt As New System.Data.DataTable()&#xA;Dim cols() As String = in_Columnas.Split(&quot;;&quot;c)&#xA;For Each c As String In cols&#xA;    dt.Columns.Add(c, GetType(String))&#xA;Next&#xA;Dim opts As RegexOptions = RegexOptions.Singleline Or RegexOptions.IgnoreCase&#xA;Dim cuerpo As String = in_Html&#xA;Dim tb As Match = Regex.Match(in_Html, &quot;&lt;tbody[^&gt;]*&gt;(.*?)&lt;/tbody&gt;&quot;, opts)&#xA;If tb.Success Then cuerpo = tb.Groups(1).Value&#xA;For Each tr As Match In Regex.Matches(cuerpo, &quot;&lt;tr[^&gt;]*&gt;(.*?)&lt;/tr&gt;&quot;, opts)&#xA;    Dim tds As MatchCollection = Regex.Matches(tr.Groups(1).Value, &quot;&lt;td[^&gt;]*&gt;(.*?)&lt;/td&gt;&quot;, opts)&#xA;    If tds.Count &lt; cols.Length Then Continue For&#xA;    Dim fila As System.Data.DataRow = dt.NewRow()&#xA;    For i As Integer = 0 To cols.Length - 1&#xA;        Dim txt As String = Regex.Replace(tds(i).Groups(1).Value, &quot;&lt;[^&gt;]+&gt;&quot;, &quot; &quot;)&#xA;        txt = System.Net.WebUtility.HtmlDecode(txt)&#xA;        txt = Regex.Replace(txt, &quot;\s+&quot;, &quot; &quot;).Trim()&#xA;        fila(i) = txt&#xA;    Next&#xA;    dt.Rows.Add(fila)&#xA;Next&#xA;out_Tabla = dt"><ui:InvokeCode.Arguments><InArgument x:TypeArguments="x:String" x:Key="in_Html">[in_Html]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_Columnas">[in_Columnas]</InArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="out_Tabla">[out_Tabla]</OutArgument></ui:InvokeCode.Arguments></ui:InvokeCode></Sequence>
