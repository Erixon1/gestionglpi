<Sequence DisplayName="CalcularAuditoria"><ui:InvokeCode DisplayName="Calcular KPIs y resumen HTML" Language="VBNet" Code="Dim venc As Integer = dtVencidos.Rows.Count&#xA;Dim tasa As Double = If(intActivos &gt; 0, Math.Round(venc * 100.0 / intActivos, 1), 0.0)&#xA;Dim promedio As Double = 0.0&#xA;Dim maximo As Integer = 0&#xA;If venc &gt; 0 Then&#xA;    promedio = Math.Round(dtVencidos.AsEnumerable().Average(Function(r) CInt(r(&quot;Días Atraso&quot;))), 1)&#xA;    maximo = dtVencidos.AsEnumerable().Max(Function(r) CInt(r(&quot;Días Atraso&quot;)))&#xA;End If&#xA;Dim leves As Integer = dtVencidos.AsEnumerable().Count(Function(r) r(&quot;Criticidad&quot;).ToString() = &quot;Leve&quot;)&#xA;Dim moder As Integer = dtVencidos.AsEnumerable().Count(Function(r) r(&quot;Criticidad&quot;).ToString() = &quot;Moderado&quot;)&#xA;Dim graves As Integer = dtVencidos.AsEnumerable().Count(Function(r) r(&quot;Criticidad&quot;).ToString() = &quot;Grave&quot;)&#xA;Dim libros As Integer = dtVencidos.AsEnumerable().Select(Function(r) r(&quot;Libro&quot;).ToString()).Distinct().Count()&#xA;&#xA;Dim k As New System.Data.DataTable()&#xA;k.Columns.Add(&quot;Indicador&quot;, GetType(String))&#xA;k.Columns.Add(&quot;Valor&quot;, GetType(Object))&#xA;k.Columns.Add(&quot;Detalle&quot;, GetType(String))&#xA;k.Rows.Add(&quot;Fecha y hora de auditoría&quot;, DateTime.Now.ToString(&quot;dd/MM/yyyy HH:mm:ss&quot;), &quot;Ejecución del bot ReadOut Avisos y Auditoría&quot;)&#xA;k.Rows.Add(&quot;Total préstamos activos&quot;, intActivos, &quot;Activo + Atrasado (no devueltos)&quot;)&#xA;k.Rows.Add(&quot;Total préstamos vencidos&quot;, venc, &quot;Fecha de devolución anterior a hoy&quot;)&#xA;k.Rows.Add(&quot;Tasa de morosidad (%)&quot;, tasa, &quot;Vencidos / Activos x 100&quot;)&#xA;k.Rows.Add(&quot;Promedio de días de atraso&quot;, promedio, &quot;Sobre préstamos vencidos&quot;)&#xA;k.Rows.Add(&quot;Mayor atraso (días)&quot;, maximo, &quot;&quot;)&#xA;k.Rows.Add(&quot;Mora leve (1-3 días)&quot;, leves, &quot;&quot;)&#xA;k.Rows.Add(&quot;Mora moderada (4-7 días)&quot;, moder, &quot;&quot;)&#xA;k.Rows.Add(&quot;Mora grave (&gt;7 días)&quot;, graves, &quot;Riesgo de pérdida&quot;)&#xA;k.Rows.Add(&quot;Inventario comprometido (títulos distintos)&quot;, libros, &quot;Libros con al menos un vencido&quot;)&#xA;k.Rows.Add(&quot;Lectores notificados&quot;, intNotificados, &quot;Correos enviados con éxito&quot;)&#xA;&#xA;Dim topL = dtVencidos.AsEnumerable().GroupBy(Function(r) r(&quot;Libro&quot;).ToString()).Select(Function(g) New With {.K = g.Key, .D = g.Max(Function(x) CInt(x(&quot;Días Atraso&quot;)))}).OrderByDescending(Function(a) a.D).Take(3).ToList()&#xA;For i As Integer = 0 To topL.Count - 1&#xA;    k.Rows.Add(&quot;Top &quot; &amp; (i + 1).ToString() &amp; &quot; libro con mayor mora&quot;, topL(i).K, topL(i).D.ToString() &amp; &quot; días&quot;)&#xA;Next&#xA;Dim topU = dtVencidos.AsEnumerable().GroupBy(Function(r) r(&quot;Usuario&quot;).ToString()).Select(Function(g) New With {.K = g.Key, .N = g.Count(), .D = g.Sum(Function(x) CInt(x(&quot;Días Atraso&quot;)))}).OrderByDescending(Function(a) a.N).ThenByDescending(Function(a) a.D).Take(3).ToList()&#xA;For i As Integer = 0 To topU.Count - 1&#xA;    k.Rows.Add(&quot;Top &quot; &amp; (i + 1).ToString() &amp; &quot; lector con retrasos&quot;, topU(i).K, topU(i).N.ToString() &amp; &quot; préstamo(s) vencido(s), &quot; &amp; topU(i).D.ToString() &amp; &quot; días acumulados&quot;)&#xA;Next&#xA;dtKpis = k&#xA;&#xA;Dim sb As New System.Text.StringBuilder()&#xA;Dim H As Func(Of String, String) = Function(s) System.Net.WebUtility.HtmlEncode(s)&#xA;sb.Append(&quot;&lt;div style='font-family:Segoe UI,Arial,sans-serif;color:#1f2937;max-width:680px'&gt;&quot;)&#xA;sb.Append(&quot;&lt;h2 style='color:#1d4ed8;margin-bottom:4px'&gt;Resumen diario de morosidad - ReadOut&lt;/h2&gt;&quot;)&#xA;sb.Append(&quot;&lt;p style='margin-top:0;color:#6b7280'&gt;&quot; &amp; DateTime.Now.ToString(&quot;dd/MM/yyyy HH:mm&quot;) &amp; &quot;&lt;/p&gt;&quot;)&#xA;sb.Append(&quot;&lt;table style='border-collapse:collapse;width:100%'&gt;&quot;)&#xA;Dim filas() As String = {&quot;Préstamos activos|&quot; &amp; intActivos, &quot;Préstamos vencidos|&quot; &amp; venc, &quot;Tasa de morosidad|&quot; &amp; tasa.ToString(&quot;0.0&quot;, System.Globalization.CultureInfo.InvariantCulture) &amp; &quot; %&quot;, &quot;Mayor atraso|&quot; &amp; maximo &amp; &quot; días&quot;, &quot;Promedio de atraso|&quot; &amp; promedio.ToString(&quot;0.0&quot;, System.Globalization.CultureInfo.InvariantCulture) &amp; &quot; días&quot;, &quot;Avisos enviados a lectores|&quot; &amp; intNotificados}&#xA;For Each f As String In filas&#xA;    Dim p() As String = f.Split(&quot;|&quot;c)&#xA;    sb.Append(&quot;&lt;tr&gt;&lt;td style='padding:6px 10px;border-bottom:1px solid #e5e7eb'&gt;&quot; &amp; H(p(0)) &amp; &quot;&lt;/td&gt;&lt;td style='padding:6px 10px;border-bottom:1px solid #e5e7eb;text-align:right'&gt;&lt;b&gt;&quot; &amp; H(p(1)) &amp; &quot;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&quot;)&#xA;Next&#xA;sb.Append(&quot;&lt;/table&gt;&quot;)&#xA;If graves &gt; 0 Then&#xA;    sb.Append(&quot;&lt;div style='margin-top:14px;padding:10px 14px;background:#fef2f2;border-left:4px solid #dc2626'&gt;&lt;b&gt;Alerta:&lt;/b&gt; &quot; &amp; graves &amp; &quot; préstamo(s) con más de 7 días de atraso (riesgo de pérdida).&lt;/div&gt;&quot;)&#xA;    sb.Append(&quot;&lt;ul&gt;&quot;)&#xA;    For Each r As System.Data.DataRow In dtVencidos.Select(&quot;[Criticidad] = 'Grave'&quot;)&#xA;        sb.Append(&quot;&lt;li&gt;&quot; &amp; H(r(&quot;Libro&quot;).ToString()) &amp; &quot; - &quot; &amp; H(r(&quot;Usuario&quot;).ToString()) &amp; &quot; (&quot; &amp; r(&quot;Días Atraso&quot;).ToString() &amp; &quot; días)&lt;/li&gt;&quot;)&#xA;    Next&#xA;    sb.Append(&quot;&lt;/ul&gt;&quot;)&#xA;ElseIf venc = 0 Then&#xA;    sb.Append(&quot;&lt;p style='margin-top:14px'&gt;No hay préstamos vencidos hoy.&lt;/p&gt;&quot;)&#xA;End If&#xA;sb.Append(&quot;&lt;p style='margin-top:14px;color:#6b7280'&gt;Se adjunta el detalle y la hoja de auditoría en Excel.&lt;/p&gt;&lt;/div&gt;&quot;)&#xA;strResumenHtml = sb.ToString()"><ui:InvokeCode.Arguments><InArgument x:TypeArguments="sd:DataTable" x:Key="dtVencidos">[in_dtVencidos]</InArgument><InArgument x:TypeArguments="x:Int32" x:Key="intActivos">[in_intActivos]</InArgument><InArgument x:TypeArguments="x:Int32" x:Key="intNotificados">[in_intNotificados]</InArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="dtKpis">[out_dtKpis]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="strResumenHtml">[out_strResumenHtml]</OutArgument></ui:InvokeCode.Arguments></ui:InvokeCode></Sequence>
</Activity>
